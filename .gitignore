# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------ הפרויקט הזה
# קובצי סביבה — מכילים מפתחות
.env
.env.local
.env*.local

# יוצא דופן יחיד: קובץ הדוגמה מכיל שמות משתנים בלבד, בלי שום ערך. הוא חייב
# להיות במאגר כדי שיהיה ברור מה צריך להגדיר. החריגה ממוקדת לשם הקובץ המדויק
# הזה, ואינה פותחת שום קובץ סביבה אחר.
!.env.example

# סרטונים וקובצי מדיה — כבדים, ולרוב תוכן של מישהו
/uploads/
/tmp/
*.mp4
*.mov
*.m4v
*.webm
*.mkv
*.avi
*.mp3
*.wav
*.m4a
