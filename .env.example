# שמות המשתנים בלבד. הערכים מוזנים ידנית ב-.env.local ולעולם לא נכנסים ל-Git.
#
# **מפתחות חדשים בלבד.** אין להשתמש במפתחות של פרויקטים אחרים: מפתח משותף
# הופך כל חריגה או דליפה כאן לבעיה גם שם.

# תמלול — Groq. https://console.groq.com
GROQ_API_KEY=

# סיכום — Anthropic. https://console.anthropic.com
ANTHROPIC_API_KEY=

# מודלים. נקראים מהשרת ולעולם לא מהדפדפן.
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
ANTHROPIC_SUMMARY_MODEL=claude-haiku-4-5-20251001

# מצב מדומה: אין קריאות בתשלום, והתוצאות מסומנות בבירור כמדומות.
# "true" = מדומה. כל ערך אחר, כולל ריק = קריאות אמיתיות בתשלום.
MOCK_PROVIDERS=true
